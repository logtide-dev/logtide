# LogTide Docker Configuration
# =============================
# Copy this file to .env and set secure passwords

# =============================================================================
# REQUIRED - Set these before starting
# =============================================================================

# Database password (use a strong random password)
DB_PASSWORD=your_secure_database_password

# Redis password (use a strong random password)
REDIS_PASSWORD=your_secure_redis_password

# API key encryption secret (minimum 32 characters)
API_KEY_SECRET=your_32_character_secret_key_here

# =============================================================================
# OPTIONAL - Customize if needed
# =============================================================================

# Database settings (defaults work for most setups)
DB_NAME=logtide
DB_USER=logtide

# Frontend API URL - AUTO-DETECTED in most cases, no configuration needed!
#
# How auto-detection works:
# - Access via http://192.168.1.100:3000 → API auto-detected at http://192.168.1.100:8080
# - Access via https://logtide.example.com (port 80/443) → Uses relative URLs (assumes reverse proxy)
#
# Only set this if you have a non-standard setup:
# PUBLIC_API_URL=http://custom-backend-host:8080

# Docker images (pin versions for production stability)
# LOGTIDE_BACKEND_IMAGE=logtide/backend:0.5.1
# LOGTIDE_FRONTEND_IMAGE=logtide/frontend:0.5.1

# Fluent Bit image (for log collection)
# Default: fluent/fluent-bit:4.2.2
# For Raspberry Pi / ARM64, you may need to build your own image or use:
#   - cr.fluentbit.io/fluent/fluent-bit:4.2.2 (official multi-arch)
#   - Custom ARM64 build
# FLUENT_BIT_IMAGE=fluent/fluent-bit:4.2.2

# Fluent Bit API key (REQUIRED when using --profile logging or --profile metrics)
# Project-scoped ingestion key, created in the UI under Project > Settings > API Keys.
# It starts with "lp_" and is shown only once.
# If left empty, Fluent Bit sends an empty X-API-Key header and every ingest request
# is rejected with 401 while the containers still look healthy.
# NOTE: the Fluent Bit container only runs when the stack is started with
# `docker compose --profile logging up -d`. It is also the syslog listener
# (port 514 UDP/TCP, RFC 3164) for network devices such as Cisco or H3C:
# without the profile, nothing listens on 514.
# FLUENT_BIT_API_KEY=lp_your_ingestion_key_here

# Timezone offset in hours for RFC 3164 syslog timestamps, which carry no
# timezone (e.g. 1 for CET, 2 for CEST, 8 for UTC+8, -5 for EST). If your
# devices send local time and this is unset, their logs are stored with a
# shifted timestamp and can land outside the UI's default 24h window.
# SYSLOG_TZ_OFFSET=0

# =============================================================================
# EMAIL NOTIFICATIONS (optional)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER and SMTP_PASS are optional - omit for unauthenticated SMTP (e.g. port 25)
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=alerts@yourdomain.com

# =============================================================================
# STORAGE ENGINE (default: timescale)
# =============================================================================
# Options: timescale, clickhouse, mongodb
# STORAGE_ENGINE=timescale

# =============================================================================
# CLICKHOUSE (when using --profile clickhouse)
# =============================================================================
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=logtide
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=your_clickhouse_password

# =============================================================================
# MONGODB (when using --profile mongodb)
# =============================================================================
# MONGODB_HOST=mongodb
# MONGODB_PORT=27017
# MONGODB_DATABASE=logtide
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=

# =============================================================================
# HORIZONTAL SCALING (advanced)
# =============================================================================
# For scaling, use docker-compose.traefik.yml:
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d --scale backend=3
#
# See docs: https://logtide.dev/docs/deployment#horizontal-scaling
